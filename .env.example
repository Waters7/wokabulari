APP_NAME=Wokabulari
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wokabulari
DB_USERNAME=wokabulari
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@wokabulari.test
MAIL_FROM_NAME="Wokabulari"

# Notifikasi WhatsApp: "log" untuk lokal; ganti dengan driver gateway di produksi.
WHATSAPP_DRIVER=log
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Boleh false di lokal untuk mempercepat uji. WAJIB true di produksi.
FACE_VERIFICATION_ENABLED=true
GEOFENCE_ENABLED=true

# Percayai semua proxy (khusus lokal, untuk uji lewat tunnel HTTPS).
TRUSTED_PROXIES=*

BACKUP_DISK=backups
BACKUP_OFFSITE_DISK=

VITE_APP_NAME="${APP_NAME}"

# Kata sandi awal peserta hasil import (wajib diganti saat login pertama). Jangan commit nilainya.
PARTICIPANT_DEFAULT_PASSWORD=

# Super admin untuk TrialSeeder (php artisan migrate:fresh --seed --seeder=TrialSeeder). Jangan commit kata sandinya.
TRIAL_ADMIN_USERNAME=admin
TRIAL_ADMIN_PASSWORD=
