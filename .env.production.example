# Produksi: wokabulari.poltekkes-manado.ac.id (lihat docs/DEPLOY-SERVER.md).
# Salin ke .env di server, isi semua nilai [..], lalu `chmod 600 .env`. JANGAN commit .env.

APP_NAME=Wokabulari
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wokabulari.poltekkes-manado.ac.id
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Port internal container aplikasi (hanya 127.0.0.1). Samakan dengan upstream di vhost nginx.
APP_PORT=8090

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wokabulari
DB_USERNAME=wokabulari
DB_PASSWORD=[ganti-password-kuat-sama-dengan-.env.db]

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=wokabulari.poltekkes-manado.ac.id
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=[ganti-password-kuat]
REDIS_PORT=6379

# Email (opsional). Bila belum ada SMTP, biarkan "log"; notifikasi tetap masuk ke aplikasi.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@poltekkes-manado.ac.id
MAIL_FROM_NAME="Wokabulari"

# Notifikasi WhatsApp: "log" sampai gateway siap.
WHATSAPP_DRIVER=log
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# WAJIB true di produksi.
FACE_VERIFICATION_ENABLED=true
GEOFENCE_ENABLED=true

# Aplikasi hanya bisa dijangkau lewat nginx host (port terikat ke 127.0.0.1), jadi aman mempercayai proxy.
TRUSTED_PROXIES=*

BACKUP_DISK=backups
BACKUP_OFFSITE_DISK=

VITE_APP_NAME="${APP_NAME}"

# Kata sandi awal peserta hasil import (wajib diganti saat login pertama).
PARTICIPANT_DEFAULT_PASSWORD=
